<?xml version="1.0"?>
<rdf:RDF xmlns="http://ontovibe.visualdataweb.org#"
     xml:base="http://ontovibe.visualdataweb.org"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:ontovibe="http://ontovibe.visualdataweb.org#">
    <owl:Ontology rdf:about="http://ontovibe.visualdataweb.org">
        <dc:contributor>Stefan Negru</dc:contributor>
        <dc:creator>Florian Haag</dc:creator>
        <dc:creator>Steffen Lohmann</dc:creator>
        <dc:date>2015-08-27</dc:date>
        <dc:description>OntoViBe is a benchmark for testing ontology visualizations. It incorporates a comprehensive set of OWL 2 language constructs and systematic combinations thereof.</dc:description>
        <dc:rights rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <dc:title>Ontology Visualization Benchmark (OntoViBe)</dc:title>
        <rdfs:comment>OntoViBe is a benchmark for testing ontology visualizations. It incorporates a comprehensive set of OWL 2 language constructs and systematic combinations thereof.</rdfs:comment>
        <rdfs:label>Ontology Visualization Benchmark (OntoViBe)</rdfs:label>
        <owl:backwardCompatibleWith rdf:resource="http://ontovibe.visualdataweb.org/1.0/imported"/>
        <owl:backwardCompatibleWith rdf:resource="http://ontovibe.visualdataweb.org/2.1"/>
        <owl:incompatibleWith rdf:resource="http://ontovibe.visualdataweb.org/minimal"/>
        <owl:priorVersion rdf:resource="http://ontovibe.visualdataweb.org/1.0/imported"/>
        <owl:priorVersion rdf:resource="http://ontovibe.visualdataweb.org/2.1"/>
        <owl:versionInfo>2.0</owl:versionInfo>
        <owl:versionInfo>2.2</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/contributor"/>
    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/date -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/rights -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/rights"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://www.w3.org/2002/07/owl#hasSelf -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#hasSelf"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://ontovibe.visualdataweb.org#ComplementDatatype -->

    <rdfs:Datatype rdf:about="http://ontovibe.visualdataweb.org#ComplementDatatype">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:datatypeComplementOf rdf:resource="http://ontovibe.visualdataweb.org#DivisibleByTwoEnumeration"/>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- http://ontovibe.visualdataweb.org#DivisibleByFiveEnumeration -->

    <rdfs:Datatype rdf:about="http://ontovibe.visualdataweb.org#DivisibleByFiveEnumeration">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- http://ontovibe.visualdataweb.org#DivisibleByTwoEnumeration -->

    <rdfs:Datatype rdf:about="http://ontovibe.visualdataweb.org#DivisibleByTwoEnumeration">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</rdf:first>
                                                                                <rdf:rest>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</rdf:first>
                                                                                        <rdf:rest>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</rdf:first>
                                                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                            </rdf:Description>
                                                                                        </rdf:rest>
                                                                                    </rdf:Description>
                                                                                </rdf:rest>
                                                                            </rdf:Description>
                                                                        </rdf:rest>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- http://ontovibe.visualdataweb.org#IntersectionDatatype -->

    <rdfs:Datatype rdf:about="http://ontovibe.visualdataweb.org#IntersectionDatatype">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontovibe.visualdataweb.org#DivisibleByFiveEnumeration"/>
                    <rdf:Description rdf:about="http://ontovibe.visualdataweb.org#DivisibleByTwoEnumeration"/>
                </owl:intersectionOf>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- http://ontovibe.visualdataweb.org#UnionDatatype -->

    <rdfs:Datatype rdf:about="http://ontovibe.visualdataweb.org#UnionDatatype">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontovibe.visualdataweb.org#DivisibleByFiveEnumeration"/>
                    <rdf:Description rdf:about="http://ontovibe.visualdataweb.org#DivisibleByTwoEnumeration"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- http://ontovibe.visualdataweb.org/imported#DivisibleByThreeEnumeration -->

    <rdfs:Datatype rdf:about="http://ontovibe.visualdataweb.org/imported#DivisibleByThreeEnumeration">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</rdf:first>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://ontovibe.visualdataweb.org#anonymousComplementClassProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#anonymousComplementClassProperty">
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#AnonymousClassAnchor"/>
        <rdfs:range>
            <owl:Class>
                <owl:complementOf rdf:resource="http://ontovibe.visualdataweb.org#DeprecatedClass"/>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#anonymousEnumerationClassProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#anonymousEnumerationClassProperty">
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#AnonymousClassAnchor"/>
        <rdfs:range>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontovibe.visualdataweb.org#AnotherIndividual"/>
                    <rdf:Description rdf:about="http://ontovibe.visualdataweb.org#MultiSubclassIndividual3"/>
                </owl:oneOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#anonymousIntersectionClassProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#anonymousIntersectionClassProperty">
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#AnonymousClassAnchor"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontovibe.visualdataweb.org#Class1"/>
                    <rdf:Description rdf:about="http://ontovibe.visualdataweb.org#DeprecatedClass"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#anonymousUnionClassProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#anonymousUnionClassProperty">
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#AnonymousClassAnchor"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ontovibe.visualdataweb.org#Class1"/>
                    <rdf:Description rdf:about="http://ontovibe.visualdataweb.org#DeprecatedClass"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#classToClassProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#classToClassProperty">
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#Class1"/>
        <dc:description xml:lang="es">Esto es una descripción en español de una propiedad con descripciones en varias lenguas.</dc:description>
        <dc:description xml:lang="en">This is an English description of a property with descriptions in several languages.</dc:description>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#classToClassProperty1 -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#classToClassProperty1">
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#MultiPropertyOwner"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#classToClassProperty2 -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#classToClassProperty2">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#MultiPropertyOwner"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#classToUntypedClassProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#classToUntypedClassProperty">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#cyclicProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#cyclicProperty">
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#cyclicProperty1 -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#cyclicProperty1">
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#MultiPropertyOwner"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#MultiPropertyOwner"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#cyclicProperty2 -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#cyclicProperty2">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ReflexiveProperty"/>
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#MultiPropertyOwner"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#MultiPropertyOwner"/>
        <dc:description xml:lang="de">Dies ist eine deutsche Beschreibung einer Eigenschaft, die auch einen nicht in Deutsch verfassten Kommentar enthält.</dc:description>
        <rdfs:comment xml:lang="en">This is an English comment on a property that also has a non-English description.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#cyclicProperty3 -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#cyclicProperty3">
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#MultiPropertyOwner"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#MultiPropertyOwner"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#deprecatedObjectProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#deprecatedObjectProperty">
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#disjointProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#disjointProperty">
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#FunctionalAnchor"/>
        <owl:propertyDisjointWith rdf:resource="http://ontovibe.visualdataweb.org#functionalProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#dummyProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#dummyProperty">
        <owl:equivalentProperty rdf:resource="http://ontovibe.visualdataweb.org#equivalentObjectProperty"/>
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#DisjointClass"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#equivalentObjectProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#equivalentObjectProperty"/>
    


    <!-- http://ontovibe.visualdataweb.org#functionalProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#functionalProperty">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#FunctionalAnchor"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#functionalPropertyAsInverse -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#functionalPropertyAsInverse">
        <owl:inverseOf rdf:resource="http://ontovibe.visualdataweb.org#inverseFunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#FunctionalAnchor"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#inverseFunctionalProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#inverseFunctionalProperty">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#FunctionalAnchor"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#oppositeDummyProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#oppositeDummyProperty">
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org#DisjointClass"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#subproperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#subproperty">
        <rdfs:subPropertyOf rdf:resource="http://ontovibe.visualdataweb.org#deprecatedObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org#untypedClassToClassProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org#untypedClassToClassProperty">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org#PropertyOwner"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org/imported#deprecatedImportedObjectProperty -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org/imported#deprecatedImportedObjectProperty">
        <rdfs:range rdf:resource="http://ontovibe.visualdataweb.org/imported#ImportedClass"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org/imported#importedObjectPropertyWithDomain -->

    <owl:ObjectProperty rdf:about="http://ontovibe.visualdataweb.org/imported#importedObjectPropertyWithDomain">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://ontovibe.visualdataweb.org/imported#ImportedClass"/>
    </owl:ObjectProperty>
    


    <!-- http://ontovibe.visualdataweb.org/imported#importedObjectPropertyWithRange -->

