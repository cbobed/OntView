    <!-- http://ontovibe.visualdataweb.org#DisjointClass -->

    <owl:Class rdf:about="http://ontovibe.visualdataweb.org#DisjointClass">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontovibe.visualdataweb.org#oppositeDummyProperty"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">5</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontovibe.visualdataweb.org#oppositeDummyProperty"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">15</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://ontovibe.visualdataweb.org#LargeUnionClass"/>
        <rdfs:label xml:lang="en">disjoint class</rdfs:label>
        <rdfs:label xml:lang="de">disjunkte Klasse</rdfs:label>
    </owl:Class>
    


